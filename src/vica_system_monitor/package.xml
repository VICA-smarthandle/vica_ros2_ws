<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vica_system_monitor</name>
  <version>0.1.0</version>
  <description>VICA 전체 상태 감시와 앱 진단 표시용 관측 계층</description>
  <maintainer email="mjw41177@gmail.com">minsmart</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>vica_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>lifecycle_msgs</depend>

  <!-- 표준 진단 집계기. 노드를 launch에서 실행만 하므로 exec만 필요하다. -->
  <exec_depend>diagnostic_aggregator</exec_depend>

  <!-- nvblox slice 감시용. symlink가 빠져도 어댑터가 그 probe만 건너뛰도록
       optional import로 감싸므로 depend가 아니라 exec_depend다. -->
  <exec_depend>nvblox_msgs</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
