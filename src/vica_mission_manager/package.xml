<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vica_mission_manager</name>
  <version>0.1.0</version>
  <description>
    VICA 음성-주행 통합 mission manager (진행순서 2).
    /vica/intent 게이트 심사 후 통과 시에만 NavigateToPose 를 보낸다.
  </description>
  <maintainer email="devlee792458@gmail.com">tony</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>std_srvs</depend>
  <depend>vica_interfaces</depend>
  <depend>nav2_simple_commander</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- 사람 접근 트리 파일(vica_nav2/behavior_trees)을 approach_bt_xml:=auto 로 찾는다. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>vica_nav2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
