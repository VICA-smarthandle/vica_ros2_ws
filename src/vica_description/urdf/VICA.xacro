<link name="laser_frame">
  <inertial>
    <origin xyz="0.0 0.0 0.010868727234877334" rpy="0 0 0"/>
    <mass value="0.16353480730457975"/>
    <inertia ixx="5.9e-05" iyy="5.9e-05" izz="0.000105" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.185 -0.0 ${-(laser_z + body_center_z)}" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://vica_description/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.185 -0.0 ${-(laser_z + body_center_z)}" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://vica_description/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="camera_link">
  <!-- D455 visual placeholder: 26 x 124 x 29 mm -->
  <visual name="d455_body">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.026 0.124 0.029"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<joint name="left_wheel_joint" type="continuous">
  <origin xyz="${0.154 - axle_offset_x} ${wheel_y} -0.125" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
  <origin xyz="${0.154 - axle_offset_x} ${-wheel_y} -0.125" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="front_left_caster_wheel_joint" type="continuous">
  <origin xyz="-0.03 ${caster_wheel_dy} -0.0655" rpy="0 0 0"/>
  <parent link="front_left_caster_steer_1"/>
  <child link="front_left_caster_wheel_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="front_right_caster_wheel_joint" type="continuous">
  <origin xyz="-0.03 ${-caster_wheel_dy} -0.0655" rpy="0 0 0"/>
  <parent link="front_right_caster_steer_1"/>
  <child link="front_right_caster_wheel_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="front_right_caster_steer_joint" type="continuous">
  <origin xyz="${-0.222 - axle_offset_x} ${-caster_steer_y} -0.0825" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_right_caster_steer_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="front_left_caster_steer_joint" type="continuous">
  <origin xyz="${-0.222 - axle_offset_x} ${caster_steer_y} -0.0825" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_left_caster_steer_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<!-- Sensor positions are expressed relative to the body-centered base_link. -->
<joint name="laser_joint" type="fixed">
  <origin xyz="${laser_x - axle_offset_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="laser_frame"/>
</joint>

<!-- 초음파: 빔 축 = +x(전방), 수평. Range 메시지의 부채꼴이 이 frame 에서 그려진다.

     visual 은 DYP-A22 일반 규격(방수 원통형)을 옮긴 것이다. 2026-09-02 추가.
     [미검증] 실물을 재서 넣은 값이 아니다. 줄자로 확인하면 아래 두 값만 고친다.

     링크 원점은 **센서 앞면**(측정 원점)이고 몸체는 그 뒤로 뻗는다. 그래서
     원통 중심을 길이의 절반만큼 -x 로 물린다. 이걸 빼먹으면 실물보다 20 mm
     앞으로 튀어나온 것처럼 그려져, 범퍼 앞면(usonic_x 0.305)과의 관계를 눈으로
     확인할 때 잘못 읽게 된다.

     URDF cylinder 의 축은 z 다. 빔 축 +x 에 맞추려면 y 로 90도 눕힌다.

     collision 은 넣지 않는다. 주행 충돌 판정은 nav2 footprint 가 하고 URDF
     collision 은 거기에 관여하지 않는다. 시각 확인이 목적이므로 보이는 것만 둔다. -->
<xacro:property name="usonic_diameter" value="0.022" />
<xacro:property name="usonic_length" value="0.020" />

<xacro:macro name="usonic_visual">
  <visual name="dyp_a22_body">
    <origin xyz="${-usonic_length/2} 0 0" rpy="0 ${pi/2} 0"/>
    <geometry>
      <cylinder radius="${usonic_diameter/2}" length="${usonic_length}"/>
    </geometry>
    <material name="silver"/>
  </visual>
</xacro:macro>

<link name="usonic_front_left">
  <xacro:usonic_visual/>
</link>
<joint name="usonic_front_left_joint" type="fixed">
  <origin xyz="${usonic_x - axle_offset_x} ${usonic_y} ${usonic_z}" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="usonic_front_left"/>
</joint>

<link name="usonic_front_right">
  <xacro:usonic_visual/>
</link>
<joint name="usonic_front_right_joint" type="fixed">
  <origin xyz="${usonic_x - axle_offset_x} ${-usonic_y} ${usonic_z}" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="usonic_front_right"/>
</joint>

<!-- ── 2026-09-23 초음파 6개 추가 → 8개 배치 (자리↔주소 실측표: devlog/2026-09-22-esp32-스마트핸들-이식.md) ──
     아래 x/y 는 줄자 실측이 **아니라 차체 치수(footprint 주석)에서 추정한 값**이다 [미검증].
     기준은 앞 센서와 같은 차체 중심이고, joint 에서 axle_offset_x 를 뺀다.
       바퀴 옆(1·4번)      x = +0.154 (구동륜 축)          y = ±0.225 (차체 반폭)
       뒷바퀴 옆(8·5번)    x = -0.252 (앞 캐스터 x 의 대칭 가정) y = ±0.225
       후방(7·6번)         x = -0.305 (차체 뒷면)          y = ±0.107 (앞 센서와 같은 간격 가정)
       높이는 전부 앞 센서와 같다고 가정(usonic_z).
     yaw 는 센서가 보는 방향: 왼쪽 +90° / 오른쪽 -90° / 후방 180°. 부채꼴(Range)은 이
     방향으로 그려지므로, RViz 에서 실물과 어긋나면 **줄자로 재서 이 값들을 고친다.**
     link 이름은 user_guidance.yaml 의 ultrasonic_frame_ids 와 반드시 일치해야 한다. -->
<xacro:property name="usonic_side_x"       value="0.154" />
<xacro:property name="usonic_side_y"       value="0.225" />
<xacro:property name="usonic_rear_wheel_x" value="-0.252" />
<xacro:property name="usonic_rear_x"       value="-0.305" />

<xacro:macro name="usonic_link" params="name x y yaw">
  <link name="${name}">
    <xacro:usonic_visual/>
  </link>
  <joint name="${name}_joint" type="fixed">
    <origin xyz="${x - axle_offset_x} ${y} ${usonic_z}" rpy="0 0 ${yaw}"/>
    <parent link="base_link"/>
    <child link="${name}"/>
  </joint>
</xacro:macro>

<xacro:usonic_link name="usonic_left_wheel"       x="${usonic_side_x}"       y="${usonic_side_y}"  yaw="${pi/2}"/>   <!-- 1번 -->
<xacro:usonic_link name="usonic_right_wheel"      x="${usonic_side_x}"       y="${-usonic_side_y}" yaw="${-pi/2}"/>  <!-- 4번 -->
<xacro:usonic_link name="usonic_right_rear_wheel" x="${usonic_rear_wheel_x}" y="${-usonic_side_y}" yaw="${-pi/2}"/>  <!-- 5번 -->
<xacro:usonic_link name="usonic_rear_right"       x="${usonic_rear_x}"       y="${-usonic_y}"      yaw="${pi}"/>     <!-- 6번 -->
<xacro:usonic_link name="usonic_rear_left"        x="${usonic_rear_x}"       y="${usonic_y}"       yaw="${pi}"/>     <!-- 7번 -->
<xacro:usonic_link name="usonic_left_rear_wheel"  x="${usonic_rear_wheel_x}" y="${usonic_side_y}"  yaw="${pi/2}"/>   <!-- 8번 -->

<!-- 마스트 장착 기울기. 2026-08-29 실측으로 위 3.0도(camera_pitch)를 넣었다.
     이 값은 "이렇게 달자"는 설계값이 아니라 "실제로 이렇게 달려 있다"는 실측값이다.
     마스트를 손대면 반드시 다시 재서 이 값을 고쳐야 한다. 안 고치면 바닥이
     장애물로 찍혀 앞이 막힌다(2026-08-29 실주행에서 겪음).
     재는 도구: 바닥 평면 RANSAC. 절차는 camera_pitch 선언부 주석 참조.

     아래로 더 기울여 달면 pitch(가운데 값)만 바꾼다. URDF 는 pitch 양수 = 아래.
       아래 15도(권장): rpy="0 0.262 0"  바닥 사각 앞끝 1.17 -> 0.46 m,
                        0.35 m 앞 사람의 허벅지~가슴이 화면에 들어온다
       아래 20도(한계): 앞쪽 0.385 m 구조물(x 0.1~0.3, STL 실측)이 화면
                        하단에 걸리기 시작한다. 이 위로 기울이지 말 것.
     기울기를 바꿔도 IMU 어댑터 파라미터는 안 바꾼다 - TF 회전을 자동으로 읽는다. -->
<joint name="camera_joint" type="fixed">
  <origin xyz="${camera_x - axle_offset_x} ${camera_y} ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  <parent link="base_link"/>
  <child link="camera_link"/>
</joint>


<!-- REP-103: +Z forward, +X right, +Y down -->
<!-- 실물은 RealSense 드라이버가 자체 발행하지만, Isaac에는 드라이버가 없어
     URDF가 제공해야 한다. 정본을 하나로 유지하려고 여기에 둔다. -->
<link name="camera_optical_frame"/>
<joint name="camera_optical_joint" type="fixed">
  <origin xyz="0 0 0" rpy="-${pi/2} 0 -${pi/2}"/>
  <parent link="camera_link"/>
  <child  link="camera_optical_frame"/>
</joint>
</robot>
