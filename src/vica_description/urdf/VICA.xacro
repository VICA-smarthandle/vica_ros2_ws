<?xml version="1.0" ?>
<robot name="VICA" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find vica_description)/urdf/materials.xacro" />
<!-- Measured heights from the ground-aligned base_footprint. -->
<!-- base_link=0.190, laser_frame=0.382, camera_link=0.320 [m] -->
<!-- 이 값을 바꾸면 base_link/laser_frame 메시(visual·collision 4곳)만 따라온다.
     구동륜·캐스터 메시는 joint z(-0.125)와 visual z(+0.084)에 이 값을 별도로
     인코딩하고 있어 함께 손봐야 한다. -->
<xacro:property name="body_center_z" value="0.041" />
<xacro:property name="base_link_height" value="0.19" />

<!-- ── 2026-09-15 base_link 원점을 차체 중심에서 구동륜 축으로 옮긴다 ──────────
     이 로봇은 차동구동이라 **실제 회전 중심은 구동륜 축 중점**이다. 그런데
     base_link 원점은 CAD 원점인 차체 한가운데였고, 구동륜 joint 가 거기서
     x +0.154 에 있었다. 두 점이 15.4 cm 어긋나 있었다는 뜻이다.

     왜 문제인가. encoder_feedback.py 는 좌우 바퀴 이동거리의 평균과 차이로
     d_center·d_theta 를 구해 odom -> base_footprint 로 낸다(293~299행). 이
     계산이 뜻하는 점은 교과서대로 **구동륜 축 중점**이고 보정 항은 없다.
     그래서 'TF 가 실제로 추적하는 점'과 '거기 붙여 둔 몸 모양(footprint·
     라이다·카메라 위치)'이 15.4 cm 어긋나 있었다.

     결과로 나타나던 것:
       - 제자리 회전 시 뒤쪽이 쓸고 가는 반경을 Nav2 가 0.154 m 짧게 봤다
         (0.4727 -> 실제 0.6248, padding 포함). 코너에서 뒤가 스쳤다.
       - 180도 제자리 회전이면 차체 중앙이 실제로 0.308 m 움직이는데
         Nav2 는 제자리로 계산했다.
       - 라이다는 실제 회전축에서 3.1 cm 앞인데 TF 는 18.5 cm 로 알아,
         회전 중 라이다가 움직일 거리를 6배 크게 예측했다.

     로봇은 설정과 무관하게 이미 구동륜 축으로 돈다. 이 수정은 로봇을 바꾸는
     것이 아니라 로봇이 자기 몸을 제대로 알게 하는 것이다.

     같이 움직여야 하는 것(하나라도 빠지면 지도·costmap 이 전부 틀어진다):
       ① base_link 의 visual·collision·inertial origin  (이 파일)
       ② base_link 를 parent 로 하는 joint 9개          (이 파일)
       ③ nav2_params.yaml 의 footprint 2곳 · collision_monitor 다각형 2개
       ④ test_footprint_contract.py 의 실측 기준 좌표
     base_footprint 는 base_link 의 부모이고 x 오프셋이 0 이라 함께 따라온다.

     이 값이 틀리면 전부 틀린다. 줄자로 **앞 범퍼 끝에서 구동축 중심까지**를
     재면 0.305 - 0.154 = 0.151 m 가 나와야 한다. 다르면 여기만 고친다. -->
<xacro:property name="axle_offset_x" value="0.154" />

<!-- 아래 센서 x 값은 전부 **차체 중심** 기준 줄자 실측이다. base_link 원점은
     이제 구동륜 축이므로 joint 에서 axle_offset_x 를 뺀다. 실측값 자체는
     그대로 두어야 다음 사람이 줄자와 대조할 수 있다. -->
<xacro:property name="laser_x" value="0.185" />
<xacro:property name="laser_y" value="0.0" />
<xacro:property name="laser_z" value="0.192" />
<!-- 초음파 DYP-A22 x2 (2026-08-31): 앞범퍼 중앙에서 좌우 107mm, 지면 91.3mm,
     수평 장착(틸트 불가 확정). docs/handoff_jetson_ultrasonic_i2c.md §6.6.
     frame 이름은 드라이버 ultrasonic_frame_ids 와 일치해야 한다.
     z = 0.0913(지면) - 0.190(base_link) = -0.0987.
     [실측 확인] 센서가 범퍼 앞면(+0.305)보다 튀어나와 있으면 usonic_x 와
     footprint 앞단을 함께 키워야 한다(같은 문서 §6.6 주의). -->
<xacro:property name="usonic_x" value="0.305" />
<xacro:property name="usonic_y" value="0.107" />
<xacro:property name="usonic_z" value="-0.0987" />
<!-- 2026-08-24 줄자 실측으로 확정. 앞서 있던 1075 mm 는 2026-08-18 이설 때 넣은
     설계값이었고 한 번도 재본 적이 없었다. 이번 재부착으로 실제 높이가 바뀌었다.
     바닥에서 카메라 몸체 중앙까지 실측 910 mm (D455 는 렌즈가 몸체 중앙 높이에
     일렬로 놓여 몸체 중앙 = 렌즈 중심이다).
       camera_x  -0.225          (몸통 뒤끝 -305 에서 앞으로 80 mm. 이번에 그대로)
       camera_z   0.885 -> 0.720 (지면 0.910 - base_link 0.190. 16.5 cm 내려감)
     rpy 는 0 0 0 이 맞다 - D455 내장 IMU 로 재니 roll +0.24도, pitch +0.49도로
     4 m 앞 3.5 cm 수준이라 넣을 값이 없다(2026-08-24).
     ** 높이가 실물과 어긋나면 nvblox 가 깊이를 그만큼 어긋난 높이로 투영한다.
     오차 방향이 비대칭이다. URDF 가 실물보다 **높으면** 바닥이 떠올라 slice
     띠(0.05~0.9)에 걸려 주변이 통째로 장애물이 되고, **낮으면** 바닥·사람이 띠
     아래로 꺼져 nvblox 가 조용히 꺼진 것처럼 된다(2026-08-17 에 실제로 겪었다).
     카메라를 다시 달 때마다 줄자로 재서 이 값을 고친다.
     ** visual 메시(base_link_mast.stl)는 옛 1.075 기준 그대로다(2026-08-24 사용자 판단).
     RViz 에서 카메라가 마스트 그립보다 16.5 cm 아래에 그려지는데 정상이다. 메시는
     TF·footprint·nvblox 어디에도 안 물린다 - 화면 그림일 뿐이다. -->
<xacro:property name="camera_x" value="-0.225" />
<xacro:property name="camera_y" value="0.0" />
<!-- 2026-08-29 재고정: 지면 1.025 m (줄자 실측, 사용자 확정).
     camera_z = 1.025 - base_link 0.190 = 0.835. 2026-08-25 값(지면 1.05 / 0.860)에서
     2.5 cm 내려왔다. 같은 회차에 차체 세로가 80 -> 72 cm 로 줄었지만 그쪽은 이 값과
     무관하다 - nav2_params.yaml 의 footprint 후방(-0.495 -> -0.415)이 받는다.
     수평(rpy 0 0 0)은 이번에 바꾸지 않았다.

     2026-08-30 재고정: 지면 1.045 m (줄자 실측, 사용자 확정).
     camera_z = 1.045 - base_link 0.190 = 0.855. 카메라를 탈착 후 재장착하면서
     2.0 cm 올라갔다. **탈부착할 때마다 높이와 기울기를 함께 재는 것을 절차로
     삼는다** - 아래 camera_pitch 주석의 도구가 둘을 같이 출력한다. -->
<xacro:property name="camera_z" value="0.855" />
<!-- 2026-08-29 저녁 실측: 마스트가 위로 3.0도 들려 있다(pitch 음수).
     재는 법 - 깊이 포인트클라우드에서 바닥 평면을 RANSAC 으로 찾아
     그 법선의 앞뒤 성분을 읽었다(평면 두께 9 mm, 점 9,000개).
     4회 측정 3.05 / 2.88 / 3.16 / 3.06 도 -> 3.04 +- 0.14.
     부호 주의: 이 측정기가 내는 양수는 "URDF 가 믿는 자세보다 위로 들렸다"는
     뜻이라 URDF pitch 에는 부호를 뒤집어 넣는다. 처음에 +0.0524 를 넣었더니
     오차가 3도에서 6.3도로 두 배가 되어 부호를 확정했다(같은 날 실측).
     같은 측정에서 카메라 높이는 1.008 m 로 나왔다. URDF 의 1.025 와
     1.7 cm 차이인데 줄자 실측의 오차 범위라 camera_z 는 건드리지 않는다.

     왜 이 값이 필요한가: URDF 가 수평이라고 믿는 동안 바닥점이 20~40 cm
     떠서 계산됐고, local_costmap 의 깊이 소스가 그것을 통째로 장애물로
     찍어 로봇 앞이 까맣게 찼다("길이 막혔다"). 3도는 2 m 앞에서 10.5 cm 다.
     카메라를 물리적으로 수평에 맞추는 대신 실제 각도를 여기 적는다 -
     기울어져 있어도 TF 가 알기만 하면 계산은 정확해진다. -->
<xacro:property name="camera_pitch" value="-0.0124" />  <!-- 0.7 도, 위로 -->
<!-- 2026-08-30 재장착 후 재측정: 3.0도 -> 0.7도 (둘 다 위로).
     같은 회차에 높이도 1.025 -> 1.045 m 로 2 cm 올라갔다(줄자 실측).

     이 도구가 재는 것은 **URDF 기준 잔여 오차**다. TF 가 이미 camera_pitch 를
     반영하고 있기 때문이다. 따라서 새 값은 절대값이 아니라
         새 값 = 지금 값 + 잔여 오차를 되돌리는 양
     이다. 이번에 -3.00 도에서 잔여 -2.29 도가 나왔으므로 -0.71 도가 됐다.
     도구가 이 계산을 대신하도록 고쳤다(scripts/vica_camera_pitch.py).
     그 전에는 절대값을 찍어 줘서, 그대로 넣으면 오차가 오히려 커졌다.

     측정 3회 -2.35 / -2.31 / -2.24 도, 편차 0.05. 평면 두께 8 mm, 점 17,000개. -->
<!-- Drive wheel / caster geometry. Single source for every y coordinate. -->
<!-- 줄자 실측(바퀴 중심 사이). CAD 0.3618과 2.2 mm 차이.
     encoder.yaml의 wheel_base_m 0.37은 회전 시험으로 맞춘 오도메트리 보정 상수라
     이 값과 다르다. 통일 대상이 아니다 — 스펙 3.1.1절. -->
<xacro:property name="wheel_separation" value="0.364" />
<xacro:property name="wheel_y" value="${wheel_separation / 2}" />
<!-- CAD 실측: steer ±0.0845, wheel ±0.0795 -->
<xacro:property name="caster_steer_y" value="0.0845" />
<xacro:property name="caster_y" value="0.0795" />
<!-- steer 링크 기준 wheel 조인트의 y. round()는 부동소수점 꼬리를 자른다. -->
<xacro:property name="caster_wheel_dy" value="${round(caster_y - caster_steer_y, 6)}" />

<link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <origin xyz="0 0 ${base_link_height}" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="base_link"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="${0.004031215194176557 - axle_offset_x} 3.002726997808124e-17 0.03506562657816282" rpy="0 0 0"/>
    <mass value="90.84709962539795"/>
    <inertia ixx="2.402108" iyy="3.622523" izz="4.166828" ixy="0.0" iyz="-0.0" ixz="0.343284"/>
  </inertial>
  <!-- 2026-08-18 마스트 재설계 형상 - **visual 만** 교체한다(사용자 확정).
       base_link_mast.stl 은 base_link.stl 을 이렇게 가공한 것이다:
         - 뒤끝 전폭 레일(0.248~0.363)과 치마 삭제
         - 손잡이 기둥을 카메라 상자 뒤면(-0.238)에 밀착, 밑동은 차체 안까지
         - 그립은 형태 그대로 지면 1.045~1.075 (카메라 높이)
       collision 은 base_link.stl 원본 그대로다 - footprint·계약 시험의 실측
       기준이라 실물 완성 후 재실측 전에는 바꾸지 않는다.
       실물 CAD 가 나오면 이 메시를 교체한다. -->
  <visual>
    <origin xyz="${-axle_offset_x} 0 -${body_center_z}" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://vica_description/meshes/base_link_mast.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="body_blue"/>
  </visual>
  <collision>
    <origin xyz="${-axle_offset_x} 0 -${body_center_z}" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://vica_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="left_wheel_1">
  <inertial>
    <origin xyz="2.0539125955565396e-15 0.03668765550201605 0.0" rpy="0 0 0"/>
    <mass value="0.5663250710944822"/>
    <inertia ixx="0.000634" iyy="0.001025" izz="0.000634" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.154 ${-wheel_y} 0.084" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://vica_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.154 ${-wheel_y} 0.084" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://vica_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="right_wheel_1">
  <inertial>
    <origin xyz="-0.00046568184733652984 -0.03568765550201608 0.0009570426748952837" rpy="0 0 0"/>
    <mass value="0.5663250710944814"/>
    <inertia ixx="0.000634" iyy="0.001025" izz="0.000634" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
