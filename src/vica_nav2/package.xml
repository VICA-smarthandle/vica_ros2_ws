<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vica_nav2</name>
  <version>0.0.0</version>
  <description>VICA Nav2 bringup and configuration</description>
  <maintainer email="2561110043@office.kopo.ac.kr">ji_w</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <!-- planner_server가 런타임에 로드하는 GridBased plugin. -->
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>vica_localization</exec_depend>
  <!-- pose_bootstrap_node. 앱에서 Nav2 초기 위치를 잡는다. -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- 거리표 계산. 없으면 pose_score 가 numpy 만으로 하는 대비책으로 넘어간다. -->
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>vica_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
